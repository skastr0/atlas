#!/usr/bin/env bash
# Never echo the short-lived OIDC token, even when invoked with bash -x.
set +x
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/atlas-node/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$PATH"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Project runtime only. The shared resume joins the tailnet and checks Quasar.
command -v rustc >/dev/null
command -v node >/dev/null
[[ "$(node --version)" == v24.* ]] || {
  printf '[resume] expected Node 24; rerun .agents/setup\n' >&2
  exit 1
}
command -v bun >/dev/null
[[ "$(bun --version)" == 1.3.14 ]] || {
  printf '[resume] expected Bun 1.3.14; rerun .agents/setup\n' >&2
  exit 1
}

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/resume.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

orb_setup="$(locate_orb_setup)" || {
  printf '[resume] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
bash "${orb_setup}/bin/resume.sh"
